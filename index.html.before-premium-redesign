    document.getElementById("year").textContent = new Date().getFullYear();

    // Lightweight animated wireframe orb and floating particles.
    (() => {
      const canvas = document.getElementById("scene3d");
      const ctx = canvas.getContext("2d");
      if (!ctx) return;
      let w = 0, h = 0, dpr = 1, particles = [];
      const accent = "186,255,54";
      function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = Math.floor(w * dpr);
        canvas.height = Math.floor(h * dpr);
        canvas.style.width = w + "px"; canvas.style.height = h + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        particles = Array.from({length: Math.min(65, Math.floor(w / 18))}, () => ({
          x: Math.random() * w, y: Math.random() * h,
          r: Math.random() * 1.6 + .35, v: Math.random() * .32 + .08,
          a: Math.random() * .45 + .1
        }));
      }
      function draw(t) {
        ctx.clearRect(0, 0, w, h);
        particles.forEach(p => {
          p.y -= p.v;
          if (p.y < -4) { p.y = h + 4; p.x = Math.random() * w; }
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${accent},${p.a})`; ctx.fill();
        });
        const cx = w * .82, cy = h * .48, r = Math.min(w, h) * .22;
        ctx.save(); ctx.translate(cx, cy); ctx.rotate(t * .00008);
        ctx.strokeStyle = `rgba(${accent},.13)`; ctx.lineWidth = 1;
        for (let i = 0; i < 7; i++) {
          ctx.beginPath(); ctx.ellipse(0, 0, r, r * (.22 + i * .105), i * .24, 0, Math.PI * 2); ctx.stroke();
        }
        for (let i = 0; i < 9; i++) {
          ctx.beginPath(); ctx.ellipse(0, 0, r * (.25 + i * .07), r, i * .19 + t * .0001, 0, Math.PI * 2); ctx.stroke();
        }
        ctx.restore();
        requestAnimationFrame(draw);
      }
      resize(); window.addEventListener("resize", resize); requestAnimationFrame(draw);
    })();
  </script>

<script>
(() => {
  const section = document.getElementById("work");
  if (!section) return;

  const modal = document.createElement("div");
  modal.id = "project-video-modal";
  modal.setAttribute("role", "dialog");
  modal.setAttribute("aria-modal", "true");
  modal.setAttribute("aria-label", "Featured project video player");
  modal.innerHTML = `
    <div class="modal-panel">
      <button class="modal-close" type="button" aria-label="Close video">&times;</button>
      <h2 class="modal-title">Featured Project</h2>
      <video class="modal-video" controls playsinline preload="metadata">
        <source src="/videos/my-edit.mp4" type="video/mp4">
        Your browser does not support video playback.
      </video>
      <p class="modal-note">Rokz Editz · Video preview</p>
    </div>`;
  document.body.appendChild(modal);

  const video = modal.querySelector("video");
  const title = modal.querySelector(".modal-title");
  const closeButton = modal.querySelector(".modal-close");
  let previousFocus = null;

  function closeModal() {
    modal.classList.remove("is-open");
    video.pause();
    video.currentTime = 0;
    video.removeAttribute("src");
    const source = video.querySelector("source");
    source.src = "/videos/my-edit.mp4";
    video.load();
    if (previousFocus) previousFocus.focus();
  }

  function openModal(card) {
    previousFocus = card;
    const heading = card.closest(".project").querySelector("h3");
    title.textContent = heading ? heading.textContent : "Featured Project";
    modal.classList.add("is-open");
    video.querySelector("source").src = "/videos/my-edit.mp4";
    video.load();
    closeButton.focus();
  }

  section.querySelectorAll(".thumb").forEach(thumb => {
    thumb.setAttribute("role", "button");
    thumb.setAttribute("tabindex", "0");
    thumb.setAttribute("aria-label", "Play " +
      (thumb.closest(".project").querySelector("h3")?.textContent || "featured project"));

    thumb.addEventListener("click", () => openModal(thumb));
    thumb.addEventListener("keydown", event => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openModal(thumb);
      }
    });
  });

  closeButton.addEventListener("click", closeModal);
  modal.addEventListener("click", event => {
    if (event.target === modal) closeModal();
  });
  document.addEventListener("keydown", event => {
    if (event.key === "Escape" && modal.classList.contains("is-open")) {
      closeModal();
    }
  });
})();
</script>


