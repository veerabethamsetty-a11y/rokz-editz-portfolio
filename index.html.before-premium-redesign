<script>
/* ROKZ_CINEMATIC_INTRO_V1 */
(() => {
  if (window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    return;
  }


  const intro = document.createElement("div");
  intro.id = "rokz-cinematic-intro";
  intro.setAttribute("role", "dialog");
  intro.setAttribute("aria-label", "Rokz Editz introduction");
  intro.innerHTML = `
    <div class="intro-glow" aria-hidden="true"></div>
    <div class="intro-content">
      <p class="intro-kicker">Creative visuals · Crafted with purpose</p>
      <h1 class="intro-logo">ROKZ<span>EDITZ</span></h1>
      <div class="intro-rule" aria-hidden="true"></div>
      <p class="intro-caption">Your vision, in motion.</p>
    </div>
    <button class="intro-skip" type="button">Skip intro</button>
  `;
  document.body.appendChild(intro);

  let finished = false;
  function finishIntro() {
    if (finished) return;
    finished = true;
    intro.classList.add("intro-exit");
    window.setTimeout(() => intro.remove(), 900);
  }

  intro.querySelector(".intro-skip").addEventListener("click", finishIntro);
  window.setTimeout(finishIntro, 5000);
})();
</script>

