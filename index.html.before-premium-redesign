<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090a09">
  <title>Rokz Editz | Video Editor & Creative Portfolio</title>
  <meta name="description" content="Rokz Editz — cinematic edits, reels, transitions and creative video storytelling.">
  <style>
    :root {
      --bg: #090a09;
      --panel: #111310;
      --panel-2: #171a15;
      --text: #f4f5f0;
      --muted: #a0a49a;
      --accent: #baff36;
      --line: rgba(255,255,255,.12);
      --max: 1160px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body {
      background: var(--bg); color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.6; overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    button, input, textarea { font: inherit; }
    .wrap { width: min(var(--max), calc(100% - 40px)); margin-inline: auto; }
    #scene3d { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; opacity: .65; }
    .site-header { position: sticky; top: 0; z-index: 10; background: rgba(9,10,9,.86); backdrop-filter: blur(16px); border-bottom: 1px solid var(--line); }
    .nav { min-height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
    .brand { font-size: 19px; font-weight: 900; letter-spacing: .08em; }
    .brand span { color: var(--accent); }
    .nav-links { display: flex; align-items: center; gap: 26px; color: #d5d8cf; font-size: 13px; }
    .nav-links a:hover, .text-link:hover { color: var(--accent); }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 17px; border: 1px solid var(--line); border-radius: 5px; font-size: 12px; font-weight: 800; letter-spacing: .07em; transition: .2s; }
    .btn.primary { background: var(--accent); color: #10120b; border-color: var(--accent); }
    .btn.primary:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(186,255,54,.16); }
    .btn.secondary:hover { border-color: var(--accent); color: var(--accent); }
    .hero { min-height: 620px; display: grid; grid-template-columns: 1.2fr .8fr; align-items: center; gap: 50px; padding-block: 90px 100px; }
    .eyebrow { color: var(--accent); font-size: 11px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; margin-bottom: 17px; }
    h1 { font-size: clamp(46px, 7vw, 86px); line-height: .98; letter-spacing: -.065em; max-width: 760px; }
    h1 .outline { color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.78); }
    .hero-copy { color: var(--muted); max-width: 520px; margin-top: 24px; font-size: 16px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .hero-art { min-height: 350px; position: relative; display: grid; place-items: center; }
    .orb { width: min(330px, 75vw); aspect-ratio: 1; border: 1px solid rgba(186,255,54,.6); border-radius: 50%; position: relative; box-shadow: inset 0 0 60px rgba(186,255,54,.06), 0 0 80px rgba(186,255,54,.06); transform: rotate(-20deg); }
    .orb:before, .orb:after { content: ""; position: absolute; inset: 13%; border: 1px solid rgba(186,255,54,.45); border-radius: 50%; transform: rotate(55deg) scaleX(.48); }
    .orb:after { transform: rotate(-55deg) scaleX(.48); }
    .orb-core { position: absolute; width: 11px; height: 11px; background: var(--accent); border-radius: 50%; top: 25%; left: 23%; box-shadow: 0 0 25px var(--accent); }
    .art-label { position: absolute; bottom: 5%; right: 0; border: 1px solid var(--line); background: #10120de8; padding: 15px 18px; font-size: 11px; letter-spacing: .1em; }
    section { padding-block: 80px; border-top: 1px solid rgba(255,255,255,.07); }
    .section-head { display: flex; align-items: end; justify-content: space-between; gap: 25px; margin-bottom: 32px; }
    h2 { font-size: clamp(30px, 4.2vw, 48px); line-height: 1.08; letter-spacing: -.045em; }
    .sub { color: var(--muted); margin-top: 12px; max-width: 610px; font-size: 14px; }
    .text-link { color: var(--accent); font-size: 11px; font-weight: 800; letter-spacing: .1em; white-space: nowrap; }
    .projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 18px; }
    .project { min-width: 0; }
    .thumb { position: relative; overflow: hidden; border: 1px solid var(--line); border-radius: 7px; background: var(--panel); }
    .thumb img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .5s ease; }
    .project:hover .thumb img { transform: scale(1.045); }
    .play-badge { position: absolute; right: 14px; bottom: 14px; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--accent); color: #111; font-size: 15px; box-shadow: 0 0 24px rgba(186,255,54,.18); }
    .project-info { display: flex; justify-content: space-between; gap: 12px; padding: 15px 2px 7px; }
    .project-info h3 { font-size: 17px; line-height: 1.35; }
    .project-info p { color: var(--muted); font-size: 12px; margin-top: 5px; }
    .arrow { color: var(--accent); font-size: 19px; }
    .video-feature { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 35px; align-items: center; }
    .video-shell { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #111; }
    .video-shell video { display: block; width: 100%; max-height: 650px; aspect-ratio: 9 / 16; object-fit: contain; background: #111; }
    .video-note { color: var(--muted); font-size: 13px; margin-top: 15px; }
    .services { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; margin-top: 30px; }
    .service { padding: 25px; min-height: 180px; background: rgba(17,19,16,.75); border: 1px solid var(--line); border-radius: 6px; }
    .service .number { color: var(--accent); font-size: 12px; letter-spacing: .1em; }
    .service h3 { margin-top: 25px; font-size: 19px; }
    .service p { margin-top: 8px; color: var(--muted); font-size: 13px; }
    .about-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 60px; align-items: start; }
    .about-copy { color: var(--muted); font-size: 15px; }
    .about-copy p + p { margin-top: 15px; }
    .contact-panel { border: 1px solid var(--line); background: linear-gradient(135deg, rgba(186,255,54,.07), rgba(17,19,16,.8) 50%); border-radius: 8px; padding: clamp(25px, 6vw, 60px); display: flex; align-items: end; justify-content: space-between; gap: 30px; }
    .contact-panel h2 { font-size: clamp(34px, 5.5vw, 65px); }
    .contact-panel p { color: var(--muted); max-width: 500px; margin-top: 15px; }
    footer { border-top: 1px solid var(--line); padding: 25px 0; color: var(--muted); font-size: 12px; }
    .footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    @media (max-width: 800px) {
      .nav { min-height: 68px; }
      .nav-links { gap: 13px; font-size: 12px; }
      .nav-cta { display: none; }
      .hero { grid-template-columns: 1fr; padding-block: 75px; gap: 10px; }
      .hero-art { min-height: 270px; }
      .orb { width: 240px; }
      .projects { grid-template-columns: repeat(2, minmax(0,1fr)); }
      .video-feature, .about-grid { grid-template-columns: 1fr; gap: 25px; }
      .video-shell { max-width: 440px; }
      .services { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) {
      .wrap { width: min(var(--max), calc(100% - 28px)); }
      .nav-links { gap: 10px; }
      .nav-links a { font-size: 11px; }
      .brand { font-size: 15px; }
      .section-head { align-items: start; flex-direction: column; }
      .projects { grid-template-columns: 1fr; }
      .thumb img { aspect-ratio: 4 / 3; }
      .contact-panel, .footer-inner { align-items: start; flex-direction: column; }
    }
  
