/* ROKZ EDITZ — clean cinematic intro */
#rokz-cinematic-intro {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: #10110f;
  color: #f5f5f0;
  opacity: 1;
  visibility: visible;
  transition: opacity .8s ease, visibility .8s ease;
}
#rokz-cinematic-intro.intro-exit {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
#rokz-cinematic-intro .intro-content {
  position: relative;
  z-index: 2;
  width: 100%;
  padding: 24px;
  text-align: center;
  animation: rokzIntroRise 1s cubic-bezier(.2,.7,.2,1) both;
}
#rokz-cinematic-intro .intro-kicker {
  margin: 0 0 18px;
  color: #a6a99f;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .38em;
  text-transform: uppercase;
}
#rokz-cinematic-intro .intro-logo {
  margin: 0;
  font-size: clamp(34px, 8vw, 72px);
  line-height: 1.05;
  font-weight: 800;
  letter-spacing: .12em;
}
#rokz-cinematic-intro .intro-logo span {
  display: block;
  margin-top: 12px;
  color: #baff36;
  font-size: .42em;
  letter-spacing: .48em;
}
#rokz-cinematic-intro .intro-rule {
  width: min(220px, 55vw);
  height: 1px;
  margin: 28px auto 16px;
  overflow: hidden;
  background: rgba(255,255,255,.14);
}
#rokz-cinematic-intro .intro-rule::after {
  display: block;
  width: 45%;
  height: 100%;
  content: "";
  background: #baff36;
  animation: rokzIntroSweep 1.5s ease-in-out infinite;
}
#rokz-cinematic-intro .intro-caption {
  margin: 0;
  color: #a6a99f;
  font-size: 11px;
  letter-spacing: .18em;
  text-transform: uppercase;
}
#rokz-cinematic-intro .intro-skip {
  position: absolute;
  right: 24px;
  bottom: 24px;
  z-index: 3;
  padding: 10px 14px;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px;
  background: transparent;
  color: #f5f5f0;
  font: inherit;
  font-size: 12px;
  cursor: pointer;
}
#rokz-cinematic-intro .intro-skip:hover {
  border-color: #baff36;
  color: #baff36;
}
#rokz-cinematic-intro .intro-glow {
  position: absolute;
  width: min(65vw, 520px);
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(186,255,54,.08), transparent 68%);
  pointer-events: none;
}
@keyframes rokzIntroRise {
  from { opacity: 0; transform: translateY(14px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes rokzIntroSweep {
  from { transform: translateX(-120%); }
  to { transform: translateX(250%); }
}
@media (prefers-reduced-motion: reduce) {
  #rokz-cinematic-intro,
  #rokz-cinematic-intro .intro-content {
    animation: none !important;
    transition: none !important;
  }
  #rokz-cinematic-intro .intro-rule::after {
    animation: none !important;
  }
}


/* Premium cinematic intro enhancement */
#rokz-cinematic-intro {
  background:
    radial-gradient(ellipse at 50% 45%, rgba(186,255,54,.09), transparent 42%),
    linear-gradient(145deg, #080908 0%, #151712 48%, #080908 100%);
}
#rokz-cinematic-intro::before {
  content: "";
  position: absolute;
  inset: 18px;
  border: 1px solid rgba(255,255,255,.09);
  pointer-events: none;
}
#rokz-cinematic-intro .intro-logo {
  text-shadow: 0 0 34px rgba(186,255,54,.12);
  animation: rokzPremiumReveal 1.3s cubic-bezier(.2,.7,.2,1) both;
}
#rokz-cinematic-intro .intro-logo span {
  text-shadow: 0 0 28px rgba(186,255,54,.2);
}
#rokz-cinematic-intro .intro-content {
  animation-duration: 1.3s;
}
#rokz-cinematic-intro .intro-rule {
  height: 2px;
}
@keyframes rokzPremiumReveal {
  from { opacity: 0; letter-spacing: .3em; filter: blur(5px); }
  to { opacity: 1; letter-spacing: .12em; filter: blur(0); }
}

